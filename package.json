{
  "name": "dsh-chat-114",
  "description": "把各家 AI 编程工具的对话记录导入 DeepSeek Harness 的会话导入插件（dsh-chat-import 的 fork）。新增 Codex .zst 支持、导入会话只读与分叉续聊。 | Import conversation history from other AI coding agents into DeepSeek Harness. A fork of dsh-chat-import with Codex .zst support, read-only imports and fork-to-continue.",
  "version": "0.27.0",
  "type": "module",
  "main": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "icon": "assets/import.svg",
  "bin": {
    "dsh-chat-114": "bin/dsh-chat-import.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./export.mjs": "./lib/export/index.mjs",
    "./CHANGELOG.md": "./CHANGELOG.md",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.mjs",
    "lib/*.js",
    "lib/index.d.ts",
    "lib/convert",
    "lib/discovery",
    "lib/export",
    "lib/sources",
    "lib/tools",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "docs/*.md",
    "docs/*.png",
    "CHANGELOG.md",
    "assets/import.svg",
    "assets/dci-promo.png",
    "assets/agents",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.0.0",
    "react": ">=18.0.0"
  },
  "keywords": [
    "dsh-chat-114",
    "fork",
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "claude-code",
    "codex",
    "chatgpt",
    "cursor",
    "gemini",
    "antigravity",
    "reasonix",
    "pi-coding-agent",
    "opencode",
    "zcode",
    "grokbuild",
    "openclaw",
    "hermes",
    "kimi",
    "kimi-cli",
    "qoder",
    "qoder-cli",
    "workbuddy",
    "trae",
    "trae-work",
    "sqlite",
    "import",
    "jsonl",
    "migration",
    "transcript"
  ],
  "author": "Nwflower <1679659@qq.com>",
  "homepage": "https://github.com/NuclearSnack/dsh-chat-114",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NuclearSnack/dsh-chat-114.git"
  },
  "bugs": {
    "url": "https://github.com/NuclearSnack/dsh-chat-114/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "coverage": "node --test --test-reporter=spec --experimental-test-coverage --test-coverage-lines=75 \"test/*.test.mjs\"",
    "check:coverage": "npm run coverage | node .github/scripts/check-coverage.mjs",
    "lint": "eslint .",
    "check:linux": "node .github/scripts/check-linux-compat.mjs",
    "check:leaks": "node .github/scripts/check-leaks.mjs",
    "check:links": "node .github/scripts/check-doc-links.mjs",
    "check:tests": "node .github/scripts/check-test-discipline.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build": "node scripts/build-client.mjs --check && node .github/scripts/build-check.mjs",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "devDependencies": {
    "eslint": "^10.8.1"
  },
  "dependencies": {
    "fzstd": "^0.1.1"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
